generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum HRRole {
  ADMIN
  HR
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum CandidateFileType {
  CV
  VIDEO
}

enum ApplicationStatus {
  APPLIED
  IN_PROGRESS
  COMPLETED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFER
  REJECTED
  HIRED
  WITHDRAWN
}

enum AssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PROCESSING
  ERROR
}

enum AssessmentStageType {
  PROFILE
  CV
  TEST
  CASE
  SCRIPT
  LIVE_SALES
  VIDEO
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PROCESSING
  ERROR
}

enum QuestionType {
  SINGLE_CHOICE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AIResultStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum Recommendation {
  ADVANCE         // = STRONG_RECOMMENDATION (spec §20)
  RECOMMEND_INTERVIEW // spec §20
  REVIEW          // = REVIEW (spec §20)
  REJECT          // = NOT_RECOMMENDED (spec §20)
}

// ==========================================
// MODELS
// ==========================================

model Company {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique @default(cuid()) // Will be overridden, ensures no nulls on migration
  description String?
  website     String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  jobs        Job[]
  auditLogs   AuditLog[]
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  firstName    String?
  lastName     String?
  email        String   @unique
  passwordHash String
  role         HRRole   @default(HR)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company  @relation(fields: [companyId], references: [id])
}

model Job {
  id             String         @id @default(uuid())
  companyId      String
  title          String
  description    String?
  department     String?
  employmentType EmploymentType @default(FULL_TIME)
  status         JobStatus      @default(DRAFT)
  salaryMin      Float?
  salaryMax      Float?
  currency       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company        Company        @relation(fields: [companyId], references: [id])
  assessments    Assessment[]
  applications   Application[]
  questions      Question[]

  @@index([companyId])
  @@index([status])
}

model Candidate {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  phone     String   @unique
  email     String?  @unique
  city      String?
  cvUrl     String?  // Legacy field from Phase 1, keeping for backwards compatibility if needed
  passwordHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments    Assessment[]
  applications   Application[]
  files          CandidateFile[]
  answers        CandidateAnswer[]
  textSubmissions TextSubmission[]

  @@index([phone])
  @@index([email])
  @@index([createdAt])
}

model CandidateFile {
  id               String            @id @default(uuid())
  candidateId      String
  type             CandidateFileType
  storageKey       String
  originalFileName String
  mimeType         String
  fileSize         Int
  createdAt        DateTime          @default(now())

  candidate        Candidate         @relation(fields: [candidateId], references: [id])
}

model Application {
  id          String            @id @default(uuid())
  candidateId String
  jobId       String
  status      ApplicationStatus @default(APPLIED)
  source      String            @default("DIRECT_LINK")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  candidate   Candidate         @relation(fields: [candidateId], references: [id])
  job         Job               @relation(fields: [jobId], references: [id])
  assessments Assessment[]

  @@index([jobId])
  @@index([candidateId])
  @@index([status])
  @@index([createdAt])
}

model Assessment {
  id              String           @id @default(uuid())
  applicationId   String?
  jobId           String           // Keeping from Phase 1
  candidateId     String           // Keeping from Phase 1
  token           String           @unique @default(uuid()) // Phase 1 token field, kept to avoid drop
  secureTokenHash String?          @unique                  // New Phase 2 secure token hash
  status          AssessmentStatus @default(NOT_STARTED)
  totalScore      Float?
  startedAt       DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  application     Application?     @relation(fields: [applicationId], references: [id])
  job             Job              @relation(fields: [jobId], references: [id])
  candidate       Candidate        @relation(fields: [candidateId], references: [id])
  results         AssessmentResult[]
  stages          AssessmentStage[]
  stageConfigs    AssessmentStageConfig[]

  @@index([applicationId])
  @@index([secureTokenHash])
}

model AssessmentStage {
  id           String              @id @default(uuid())
  assessmentId String
  type         AssessmentStageType
  order        Int
  status       StageStatus         @default(NOT_STARTED)
  startedAt    DateTime?
  completedAt  DateTime?
  score        Float?
  maxScore     Float?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  assessment   Assessment          @relation(fields: [assessmentId], references: [id])
  answers      CandidateAnswer[]
  submissions  TextSubmission[]
  aiResults    AIResult[]
  scoreBreakdowns ScoreBreakdown[]

  @@index([assessmentId])
  @@index([type])
}

model Question {
  id            String       @id @default(uuid())
  jobId         String
  type          QuestionType @default(SINGLE_CHOICE)
  category      String
  questionText  String
  options       Json         // Array of options
  correctAnswer String
  explanation   String?      @db.Text // Spec §8: explanation maydoni
  points        Float        @default(1.0)
  difficulty    Difficulty   @default(MEDIUM)
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  job           Job          @relation(fields: [jobId], references: [id])
  answers       CandidateAnswer[]
}

model CandidateAnswer {
  id                String          @id @default(uuid())
  assessmentStageId String
  questionId        String
  candidateId       String
  answer            String
  isCorrect         Boolean         @default(false)
  score             Float           @default(0.0)
  submittedAt       DateTime        @default(now())

  stage             AssessmentStage @relation(fields: [assessmentStageId], references: [id])
  question          Question        @relation(fields: [questionId], references: [id])
  candidate         Candidate       @relation(fields: [candidateId], references: [id])

  @@index([questionId])
}

model TextSubmission {
  id                String          @id @default(uuid())
  assessmentStageId String
  candidateId       String
  content           String          @db.Text
  submittedAt       DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  stage             AssessmentStage @relation(fields: [assessmentStageId], references: [id])
  candidate         Candidate       @relation(fields: [candidateId], references: [id])
}

model AIResult {
  id                String          @id @default(uuid())
  assessmentStageId String
  provider          String          @default("GEMINI")
  model             String          @default("gemini-1.5-pro")
  status            AIResultStatus  @default(PENDING)
  rawResult         Json?
  validatedResult   Json?
  errorMessage      String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  stage             AssessmentStage @relation(fields: [assessmentStageId], references: [id])
}

model ScoreBreakdown {
  id                String          @id @default(uuid())
  assessmentStageId String
  category          String
  score             Float
  maxScore          Float
  weight            Float
  evidence          String?         @db.Text
  feedback          String?         @db.Text
  createdAt         DateTime        @default(now())

  stage             AssessmentStage @relation(fields: [assessmentStageId], references: [id])
}

model AssessmentResult {
  id             String          @id @default(uuid())
  assessmentId   String
  stage          String?         // Keeping for backwards compatibility
  score          Float?
  maxScore       Float?
  data           Json?
  aiFeedback     Json?
  
  // New Phase 2 fields
  cvScore        Float?
  testScore      Float?
  caseScore      Float?
  scriptScore    Float?
  liveSalesScore Float?
  videoScore     Float?
  totalScore     Float?
  recommendation Recommendation?
  strengths      String?         @db.Text
  weaknesses     String?         @db.Text
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  assessment     Assessment      @relation(fields: [assessmentId], references: [id])
  
  @@index([totalScore])
  @@index([createdAt])
}

model AssessmentStageConfig {
  id           String              @id @default(uuid())
  assessmentId String
  stageType    AssessmentStageType
  weight       Float
  maxScore     Float               @default(100.0)
  isRequired   Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  assessment   Assessment          @relation(fields: [assessmentId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([createdAt])
}
